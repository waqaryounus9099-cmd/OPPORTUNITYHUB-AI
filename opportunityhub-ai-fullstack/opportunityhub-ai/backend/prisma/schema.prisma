generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OpportunityType {
  JOB
  SCHOLARSHIP
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  EXPIRED
  REJECTED
}

enum ApplicationStatus {
  INTERESTED
  PREPARING
  APPLIED
  ASSESSMENT
  INTERVIEW
  SHORTLISTED
  ACCEPTED
  REJECTED
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String
  role         String        @default("USER")
  plan         String        @default("FREE")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  profile      Profile?
  saved        SavedOpportunity[]
  applications Application[]
  alerts       Alert[]
  notifications Notification[]
}

model Profile {
  id             String   @id @default(cuid())
  userId         String   @unique
  country        String?
  headline       String?
  educationLevel String?
  degree         String?
  fieldOfStudy   String?
  gpa            String?
  skills         String[] @default([])
  experienceYears Int     @default(0)
  preferredCountries String[] @default([])
  interests      String[] @default([])
  cvUrl          String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Opportunity {
  id                String @id @default(cuid())
  type              OpportunityType
  title             String
  organization      String
  description       String
  country           String?
  city              String?
  locationType      String?
  employmentType    String?
  degreeLevel       String?
  field             String?
  fundingType       String?
  salaryMin         Int?
  salaryMax         Int?
  currency          String?
  publishedAt       DateTime?
  firstSeenAt       DateTime @default(now())
  lastCheckedAt     DateTime?
  deadline          DateTime?
  applicationUrl    String
  sourceUrl         String
  sourceName        String
  verificationStatus VerificationStatus @default(UNVERIFIED)
  tags              String[] @default([])
  isDemo            Boolean @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  savedBy           SavedOpportunity[]
  applications      Application[]

  @@index([type, publishedAt])
  @@index([country, deadline])
  @@index([verificationStatus])
}

model SavedOpportunity {
  id            String @id @default(cuid())
  userId        String
  opportunityId String
  createdAt     DateTime @default(now())
  user          User @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  @@unique([userId, opportunityId])
}

model Application {
  id            String @id @default(cuid())
  userId        String
  opportunityId String
  status        ApplicationStatus @default(INTERESTED)
  notes         String?
  appliedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  @@unique([userId, opportunityId])
}

model Alert {
  id          String @id @default(cuid())
  userId      String
  name        String
  keywords    String?
  type        String @default("ALL")
  country     String?
  minMatch    Int @default(70)
  frequency   String @default("DAILY")
  emailEnabled Boolean @default(true)
  browserEnabled Boolean @default(false)
  active      Boolean @default(true)
  createdAt   DateTime @default(now())
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String @id @default(cuid())
  userId    String
  title     String
  message   String
  kind      String @default("INFO")
  readAt    DateTime?
  createdAt DateTime @default(now())
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
